{
  "functions": [
    {
      "source": "functions",
      "codebase": "mission-galaxy",
      "predeploy": [
        "node functions/check-project.cjs",
        "npm --prefix functions test"
      ]
    }
  ],
  "database": {
    "rules": "firebase-database.rules.json",
